rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: shipments
    // Fields: truckId, driverName, origin, destination, status, departureDate, estimatedArrival, currentLocation, notes, createdBy
    //
    // Collection: trucks
    // Fields: plateNumber, model, status
    //
    // Collection: shipments/{shipmentId}/logs
    // Fields: timestamp, location, message, updatedBy
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email_verified == true &&
        request.auth.token.email == "ti07kz@gmail.com" &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isLogistics() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'logistics')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidShipment(data) {
      return data.invoice_id is string && data.invoice_id.size() > 0 &&
             data.route in ['Tehran - Almaty', 'Amol - Almaty'] &&
             data.status in ['In Transit', 'Customs', 'Delivered', 'Delay'];
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId &&
        (request.resource.data.role == 'viewer' || (isAdmin() && request.resource.data.role == 'admin'));
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create: if isLogistics() && isValidShipment(request.resource.data);
      allow update: if isLogistics() && isValidShipment(request.resource.data);
      allow delete: if isAdmin() || (isLogistics() && resource.data.createdBy == request.auth.uid);
      
      match /logs/{logId} {
        allow read: if isAuthenticated();
        allow create: if isLogistics();
      }
    }

    match /regional_orders/{orderId} {
      // REST API verifies Firebase identities and strips legacy GPS fields for staff.
      // Firestore cannot redact fields in a document; do not permit a direct bypass.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /gps_tracking/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /driver_sessions/{chatId} {
      allow read, write: if false;
    }
    match /bot_state/{stateId} {
      allow read, write: if false;
    }

    match /saved_delivery_contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /saved_trucks/{truckId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /trucks/{truckId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /warehouse_change_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /warehouse_snapshots/{snapId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
