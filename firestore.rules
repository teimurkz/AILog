rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: shipments
    // Fields: truckId, driverName, origin, destination, status, departureDate, estimatedArrival, currentLocation, notes, createdBy
    //
    // Collection: trucks
    // Fields: plateNumber, model, status
    //
    // Collection: shipments/{shipmentId}/logs
    // Fields: timestamp, location, message, updatedBy
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email_verified == true &&
        request.auth.token.email == "ti07kz@gmail.com" &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // May change data of a CRM section. The administrator sets `access` per user
    // ({ section: 'view' | 'edit' }); without it the role decides, as before.
    function canEdit(section) {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.firebase.sign_in_provider != 'anonymous' &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         sectionEditable(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, section))
      );
    }

    function sectionEditable(profile, section) {
      return (profile.get('access', null) == null && profile.role in ['logistics', 'admin']) ||
        (profile.get('access', null) != null && profile.access.get(section, '') == 'edit');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidShipment(data) {
      return data.invoice_id is string && data.invoice_id.size() > 0 &&
             data.route in ['Tehran - Almaty', 'Amol - Almaty'] &&
             data.status in ['In Transit', 'Customs', 'Delivered', 'Delay'];
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == userId && !('access' in request.resource.data) &&
        (request.resource.data.role == 'viewer' || (isAdmin() && request.resource.data.role == 'admin'));
      // Users may edit their own profile, but never their role or section access.
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role &&
        request.resource.data.get('access', null) == resource.data.get('access', null));
      allow delete: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create: if canEdit('shipments') && isValidShipment(request.resource.data);
      allow update: if canEdit('shipments') && isValidShipment(request.resource.data);
      allow delete: if isAdmin() || (canEdit('shipments') && resource.data.createdBy == request.auth.uid);
      
      match /logs/{logId} {
        allow read: if isAuthenticated();
        allow create: if canEdit('shipments');
      }
    }

    match /regional_orders/{orderId} {
      // REST API verifies Firebase identities and strips legacy GPS fields for staff.
      // Firestore cannot redact fields in a document; do not permit a direct bypass.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /gps_tracking/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /driver_sessions/{chatId} {
      allow read, write: if false;
    }
    match /bot_state/{stateId} {
      allow read, write: if false;
    }

    // OAuth tokens, device codes and import checkpoints are server-only,
    // including for the CRM administrator. The API exposes a safe status DTO.
    match /outlook_private/{document=**} {
      allow read, write: if false;
    }
    match /outlook_imports/{document=**} {
      allow read, write: if false;
    }
    match /outlook_invoice_index/{document=**} {
      allow read, write: if false;
    }

    match /saved_delivery_contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /saved_trucks/{truckId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // "Слежка авто": trucks at our SVH. Stages (tabs) are configured by the team.
    match /truck_tracking/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if canEdit('truck-tracking') &&
        request.resource.data.status is string &&
        request.resource.data.invoice is string && request.resource.data.productName is string;
      allow delete: if canEdit('truck-tracking');
    }

    match /truck_tracking_stages/{stageId} {
      allow read: if isAuthenticated();
      allow create, update: if canEdit('truck-tracking') &&
        request.resource.data.label is string && request.resource.data.label.size() > 0;
      allow delete: if canEdit('truck-tracking');
    }

    match /trucks/{truckId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /warehouse_change_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /warehouse_snapshots/{snapId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
