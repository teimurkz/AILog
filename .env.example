# The AI Studio app is a static frontend; API requests go to Firebase Functions.
# Leave blank for the existing project's asia-east1/crmApi function.
# For the Firebase emulator: http://127.0.0.1:5001/logisticsapp-216d5/asia-east1/crmApi
VITE_CRM_API_BASE_URL=

# Existing Firebase project/database remain in firebase-applet-config.json.
FIREBASE_PROJECT_ID=logisticsapp-216d5
CRM_STORAGE_MODE=firebase
# Optional separate local server only; Firebase Functions uses runtime credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Put these values in Firebase Secret Manager when deploying Cloud Functions.
# A private local .env can also provide them to npm run telegram:webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=SilkRoadDriverBot
TELEGRAM_WEBHOOK_URL=https://asia-east1-logisticsapp-216d5.cloudfunctions.net/crmApi/api/driver/telegram/webhook
# Default local previews never consume live driver messages or send scheduled mail.
TELEGRAM_BOT_DISABLED=true
DISABLE_BACKGROUND_SCHEDULERS=true
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Optional existing integrations, configured only in the environment that runs them.
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
