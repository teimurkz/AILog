# Firebase Configuration
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
# Production defaults to Firebase. Local JSON storage is for isolated tests only.
CRM_STORAGE_MODE=firebase
# Locally, use ADC or a service-account path; never put its contents in frontend code.
GOOGLE_APPLICATION_CREDENTIALS=

# Telegram driver tracking. Run only one polling process per bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SilkRoadDriverBot
# Set true for local previews that must not consume real driver messages.
TELEGRAM_BOT_DISABLED=false
# Required in Firebase/Cloud Run mode. Configure Telegram webhook at:
# https://<your-app>/api/driver/telegram/webhook (max_connections=1)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# For isolated GPS checks without email/warehouse background jobs.
DISABLE_BACKGROUND_SCHEDULERS=false
# Road geometry for GPS start -> destination. Can point to a self-hosted OSRM.
OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# SMTP Email Dispatch Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
